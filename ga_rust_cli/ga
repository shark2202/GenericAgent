#!/usr/bin/env bash
# §9.4 Launch script: ga (Unix/macOS)
#
# Convenience wrapper for the ga binary. Searches for the binary in:
#   1. Same directory as this script (target/debug or target/release)
#   2. ~/.local/bin/ga
#   3. /usr/local/bin/ga
#   4. PATH
#
# If no binary found, offers to build from source.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

find_ga_binary() {
    # 1. Next to this script
    if [ -x "$SCRIPT_DIR/ga" ] && [ "$SCRIPT_DIR/ga" != "$0" ]; then
        echo "$SCRIPT_DIR/ga"; return 0
    fi
    # 2. target/debug
    if [ -x "$SCRIPT_DIR/target/debug/ga" ]; then
        echo "$SCRIPT_DIR/target/debug/ga"; return 0
    fi
    # 3. target/release
    if [ -x "$SCRIPT_DIR/target/release/ga" ]; then
        echo "$SCRIPT_DIR/target/release/ga"; return 0
    fi
    # 4. ~/.local/bin
    if [ -x "$HOME/.local/bin/ga" ]; then
        echo "$HOME/.local/bin/ga"; return 0
    fi
    # 5. /usr/local/bin
    if [ -x "/usr/local/bin/ga" ]; then
        echo "/usr/local/bin/ga"; return 0
    fi
    # 6. In PATH
    if command -v ga > /dev/null 2>&1; then
        which ga; return 0
    fi
    return 1
}

GA_BIN=$(find_ga_binary 2>/dev/null) || {
    echo "ga binary not found. Attempting to build from source..."
    if [ -f "$SCRIPT_DIR/Cargo.toml" ]; then
        cargo build --manifest-path "$SCRIPT_DIR/Cargo.toml" --release 2>&1
        GA_BIN="$SCRIPT_DIR/target/release/ga"
    else
        echo "ERROR: Cannot find or build ga. Please install manually." >&2
        exit 1
    fi
}

exec "$GA_BIN" "$@"
